# 复制本文件为 .env 并填入真实值（.env 已被 .gitignore 忽略，请勿外传）

# === 当前主力：DeepSeek 开放平台（OpenAI 兼容） ===
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# === 视觉模型：智谱 GLM-4V-Flash（图片识别） ===
